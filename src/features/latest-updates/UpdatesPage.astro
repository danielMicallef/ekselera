---
import Subscribe from './Subscribe.astro';
import { processMarkdown, dateLabel } from './markdown';
import './updates.css';
const { post, posts, config } = Astro.props;
// Published references are URLs; map those exact references through the shared validator.
const rendered = post ? await processMarkdown(post.body, post.data.media.map((m: any) => ({ ...m, name: m.url }))) : null;
---
<div class="latest-updates" data-brand={config.id}>
  {post ? <>
    <a href="/latest-updates/">← Latest Updates</a>
    <h1>{post.data.title}</h1>
    <p class="updates-meta">{config.authors[post.data.authorId]?.name || post.data.authorId} · <time datetime={post.data.publishedAt.toISOString()}>{dateLabel(post.data.publishedAt)}</time></p>
    <article data-post-id={post.data.postId} data-content-digest={post.data.contentDigest} class="updates-prose" set:html={rendered!.html} />
  </> : <>
    <h1>Latest Updates</h1>
    <p>News and ideas from {config.name}.</p>
    {posts.map((item: any) => <article class="updates-entry">
      <h2><a href={`/latest-updates/${item.data.slug}/`}>{item.data.title}</a></h2>
      <p class="updates-meta"><time datetime={item.data.publishedAt.toISOString()}>{dateLabel(item.data.publishedAt)}</time></p>
      <p>{item.data.summary}</p>
    </article>)}
  </>}
  <Subscribe config={config} />
</div>
