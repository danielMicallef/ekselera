{
  "name": "Ekselera",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "gh workflow run latest-updates-deploy.yml --ref main",
    "updates:validate": "node --import tsx scripts/updates-validate.ts",
    "updates:test": "node --import tsx --test tests/latest-updates/*.test.ts",
    "updates:sync": "node scripts/updates-sync.mjs",
    "publisher:check": "tsc -p workers/latest-updates-publisher/tsconfig.json",
    "publisher:test": "WRANGLER_LOG_PATH=/tmp/latest-updates-test-wrangler.log wrangler deploy --dry-run --config workers/latest-updates-publisher/wrangler.jsonc --env staging --outdir \"$PWD/.wrangler/updates-tests\" && node --import tsx --test workers/latest-updates-publisher/tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/sitemap": "^3.6.1",
    "@octokit/auth-app": "^8.3.1",
    "@react-email/render": "^2.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.9",
    "daisyui": "^5.5.14",
    "image-size": "^2.0.4",
    "mimetext": "^3.0.28",
    "postal-mime": "^4.0.4",
    "react": "^19.3.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "resend": "^6.32.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.4",
    "miniflare": "4",
    "tsx": "^4.23.15",
    "wrangler": "^4.147.0"
  }
}
